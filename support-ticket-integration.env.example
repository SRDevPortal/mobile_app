# Copy values to Render (app-support-d8yz.onrender.com) and Flutter (assets/env/flutter_erp.env).
# Do NOT commit real secrets. Share API keys / signing secrets via a private channel.

# --- ERP (Frappe REST) ---
# Render CANNOT reach http://site1.local — use a public host or a tunnel URL.
# Dev tunnel (ngrok): ngrok http 8000 → use https URL (no trailing slash)
# Example: https://diabetic-crux-unnatural.ngrok-free.dev
# bench --site site1.local set-config host_name 'https://YOUR-SUBDOMAIN.ngrok-free.dev'
ERP_BASE_URL=https://your-public-erp-site.example.com
ERP_API_KEY=
ERP_API_SECRET=

# Optional DocType overrides (defaults match mobile_app DocTypes)
ERP_TICKET_DOCTYPE=Support Ticket
ERP_MESSAGE_DOCTYPE=Support Ticket Message
ERP_MESSAGE_TICKET_FIELD=ticket

# --- App signing (must match Flutter --dart-define) ---
SUPPORT_APP_ID=sriaas-mobile-support
SUPPORT_SIGNING_SECRET=

# Render middleware
SUPPORT_ENFORCE_REQUEST_SIGNING=true

# --- Mobile app ERP sync (separate from Frappe API key above) ---
# Used by Flutter health/profile sync — site_config mobile_app_erp_token
MOBILE_APP_ERP_TOKEN=

# --- Canonical patient id for tickets ---
# Store Support Ticket.user_id = Mobile App User.external_id (Supabase/customer UUID)
